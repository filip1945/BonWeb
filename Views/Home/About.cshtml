@{
    ViewData["Title"] = "За нас";
}

<div class="about-page">

    <section class="about-hero">

        <div class="about-content">

            <div class="about-text">

                <h1>
                    Традиција која трае повеќе од две децении
                </h1>

                <p>
                    БОН е македонска компанија со 23-годишна традиција во преработка и пакување на прехранбени производи. Низ годините растеме и го прошируваме нашиот асортиман, секогаш задржувајќи го квалитетот како еден од нашите главни приоритети.

                    Нашето производство опфаќа кафе, кикирики, семки и сончоглед, јаткасти плодови, ориз, зрнести производи, суво овошје и други производи внимателно подготвени и спакувани за нашите потрошувачи.

                    Од изборот на суровините, преку процесот на преработка и пакување, до готовиот производ – посветуваме внимание на секој чекор. Благодарение на долгогодишното искуство и довербата на нашите потрошувачи, БОН денес е препознатливо име на македонскиот пазар.
                    
                </p>

                
            </div>

            <div class="about-gallery">

                <img src="~/Images/slika1.jpg" alt="BON производство">
                <img src="~/Images/slika2.jpg" alt="BON производство">
                <img src="~/Images/slika3.jpg" alt="BON магацин">
                <img src="~/Images/slika4.jpg" alt="BON производство">

            </div>

        </div>

    </section>
    
    <section class="about-stats">

        <div class="stat-item">
            <span>20+</span>
            <p>Години традиција</p>
        </div>

        <div class="stat-item">
            <span>8+</span>
            <p>Категории на производи</p>
        </div>

        <div class="stat-item">
            <span>50+</span>
            <p>Производи во понуда</p>
        </div>

    </section>
    
    <section class="location-section">

        <div class="location-header">
            <p class="about-label">ЛОКАЦИЈА</p>
            <h2>Каде се наоѓаме?</h2>
            <p>Стопански комплекс с. Зубовце, Гостивар, Македонија</p>
        </div>

        <div class="map-container">

            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2973.159546350523!2d20.881358144073765!3d41.82486247957498!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x135159b23424b061%3A0xcc7ee9a1b1c56d72!2z0JjQvdGC0LXRgC3QmtCw0YTQtSAo0JHQvtC9LdCa0LDRhNC1KQ!5e0!3m2!1smk!2smk!4v1789225123979!5m2!1smk!2smk"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin">
            </iframe>

        </div>

    </section>

</div>