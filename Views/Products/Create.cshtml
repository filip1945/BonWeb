@model BonWeb.Models.Product

<h1>Додај производ</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Име</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Опис</label>
        <input asp-for="Description" />
    </div>

    <div>
        <label>Цена</label>
        <input asp-for="Price" />
    </div>

    <div>
        <label>Слика</label>
        <input asp-for="ImageUrl" />
    </div>

    <div>
        <label>Категоријa</label>
        <select asp-for="CategoryId">
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">
                    @category.Name
                </option>
            }
        </select>
    </div>

    <button type="submit">Додај производ</button>

</form>