@model BonWeb.Models.Order

<div class="checkout-page">

    <h1>Податоци за нарачка</h1>

    <form asp-controller="Order"
          asp-action="Checkout"
          method="post"
          class="checkout-form">

        <div class="form-group">
            <label>Име и презиме</label>
            <input asp-for="FullName">
            <span asp-validation-for="FullName" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" type="email">
            <span asp-validation-for="Email" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Телефон</label>
            <input asp-for="Phone">
            <span asp-validation-for="Phone" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Адреса</label>
            <input asp-for="Address">
            <span asp-validation-for="Address" class="validation-message"></span>
        </div>

        <button type="submit" class="place-order-btn">
            Потврди нарачка
        </button>

    </form>

</div>