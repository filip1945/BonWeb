@model List<BonWeb.Models.Category>

<h1>Категории</h1>

@foreach (var category in Model)
{
    <div>
        <h3>@category.Name</h3>
    </div>
    <a asp-controller="Categories"
       asp-action="Edit"
       asp-route-id="@category.Id">
        Измени
    </a>
    <a asp-controller="Categories"
       asp-action="Delete"
       asp-route-id="@category.Id">
        Избриши
    </a>
}