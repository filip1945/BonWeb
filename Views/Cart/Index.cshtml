@model List<BonWeb.Models.CartItem>

<div class="cart-page">

    <h1>Кошничка</h1>

    @if (Model.Count == 0)
    {
        <p>Кошничката е празна.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="cart-item">

                <img src="@item.ImageUrl" alt="@item.Name">

                <div>
                    <h2>@item.Name</h2>

                    <p>
                        Цена: @item.Price ден.
                    </p>

                    <div class="quantity-controls">

                        <a asp-controller="Cart"
                           asp-action="Decrease"
                           asp-route-id="@item.ProductId"
                           class="quantity-btn">
                            -
                        </a>

                        <span>@item.Quantity</span>

                        <a asp-controller="Cart"
                           asp-action="Increase"
                           asp-route-id="@item.ProductId"
                           class="quantity-btn">
                            +
                        </a>

                    </div>

                    <a asp-controller="Cart"
                       asp-action="Remove"
                       asp-route-id="@item.ProductId"
                       class="remove-btn">
                        Избриши
                    </a>

                    <p>
                        Вкупно: @(item.Price * item.Quantity) ден.
                    </p>
                </div>

            </div>
        }
        <div class="cart-summary">

            <h2>
                Вкупно:
                @Model.Sum(item => item.Price * item.Quantity) ден.
            </h2>

        </div>
        <div class="cart-summary">

            <h2>
                Вкупно:
                @Model.Sum(item => item.Price * item.Quantity) ден.
            </h2>

            <a asp-controller="Order"
               asp-action="Checkout"
               class="checkout-btn">
                Продолжи со нарачка
            </a>

        </div>
    }

</div>