@model List<BonWeb.Models.Order>

<div class="orders-page">

    <h1>Нарачки</h1>

    @if (Model.Count == 0)
    {
        <p>Нема нарачки.</p>
    }
    else
    {
        <table class="orders-table">

            <thead>
            <tr>
                <th>ID</th>
                <th>Купувач</th>
                <th>Телефон</th>
                <th>Вкупно</th>
                <th>Датум</th>
                <th>Статус</th>
                <th></th>
            </tr>
            </thead>

            <tbody>

            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>

                    <td>@order.FullName</td>

                    <td>@order.Phone</td>

                    <td>@order.TotalPrice ден.</td>

                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    
                    <td>
                        @order.Status
                    </td>

                    <td class="order-actions">

                        <a asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@order.Id"
                           class="order-details-btn">
                            Детали
                        </a>

                        @if (order.Status == "Нова")
                        {
                            <form asp-controller="Orders"
                                  asp-action="MarkAsSent"
                                  asp-route-id="@order.Id"
                                  method="post">

                                <button type="submit"
                                        class="order-send-btn">
                                    Испрати нарачка
                                </button>

                            </form>
                        }

                    </td>
                </tr>
            }

            </tbody>

        </table>
    }

</div>